# Copy to .env and choose your own password. .env is git-ignored.

# Used by docker-compose to create the local Postgres container
POSTGRES_USER=spendsmart
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spendsmart
POSTGRES_PORT=5432

# Used by the FastAPI app (keep credentials in sync with the values above)
DATABASE_URL=postgresql+psycopg://spendsmart:change-me@localhost:5432/spendsmart

# Comma-separated list of allowed browser origins (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# --- AI coach (local Ollama for development) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# --- Tool backend for the AI coach: "direct" (in-process) or "mcp" (via the MCP server) ---
TOOL_PROVIDER=direct
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8001
